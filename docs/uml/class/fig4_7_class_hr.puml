@startuml fig4_7_class_hr
!include _style.puml
hide empty methods
class Department {
  +id: Long
  +code: String
  +name: String
  +active: boolean
}
class JobTitle {
  +id: Long
  +code: String
  +name: String
  +managerial: boolean
  +salesOwnerEligible: boolean
  +defaultBaseSalary: BigDecimal
}
class Employee {
  +id: Long
  +code: String
  +fullName: String
  +employeeType: String
  +status: String
  +hireDate: LocalDate
  +terminationDate: LocalDate
  +wageRegion: String
  +version: long
}
class Contract {
  +contractNo: String
  +contractType: String
  +startDate: LocalDate
  +endDate: LocalDate
  +status: String
  +terminationReason: String
}
class SalaryRecord {
  +baseSalary: BigDecimal
  +effectiveFrom: LocalDate
  +effectiveTo: LocalDate
  +decisionRef: String
}
class TaxProfile {
  +residency: String
  +method: String
  +taxCode: String
  +commitment08: boolean
  +status: String
  +effectiveFrom: LocalDate
}
class InsuranceProfile {
  +bhxh: boolean
  +bhyt: boolean
  +bhtn: boolean
  +insuranceSalary: BigDecimal
  +status: String
}
class Dependent {
  +fullName: String
  +relationship: String
  +registeredFrom: LocalDate
}
class UserAccount {
  +email: String
  +role: String
  +status: String
  +failedAttempts: int
  +tokenVersion: int
}
class PayrollGrant {
  +grant: String
  +scope: String
  +effectiveFrom: LocalDate
}
class EmployeeService <<service>> {
  +create(cmd)
  +update(id, cmd)
  +terminate(id, date, reason)
}
Department "1" o-- "*" Employee : thuộc
JobTitle "1" o-- "*" Employee : giữ chức danh
Employee "0..1" <-- "*" Employee : manager
Employee "1" *-- "*" Contract
Contract "1" *-- "*" SalaryRecord
Employee "1" *-- "*" TaxProfile
Employee "1" *-- "*" InsuranceProfile
Employee "1" *-- "*" Dependent
Employee "1" -- "0..1" UserAccount
UserAccount "1" *-- "*" PayrollGrant
EmployeeService ..> Employee
@enduml
