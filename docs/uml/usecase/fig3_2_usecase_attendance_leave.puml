@startuml fig3_2_usecase_attendance_leave
!include _style.puml
left to right direction
skinparam ranksep 18
skinparam nodesep 30
actor "Employee" as EMP
actor "HR" as HR
actor "Manager /\nngười duyệt" as MGR
actor "Máy chấm công\ntại quầy (KIOSK)" as KIOSK
rectangle "Nhân viên" as G1 {
  usecase "Chấm công tại quầy" as A1
  usecase "Hiển thị QR cá nhân\ntrên điện thoại" as A2
  usecase "Xem bảng công của mình" as A4
  usecase "Tạo và gửi đơn nghỉ" as L1
  usecase "Kiểm tra số dư quỹ phép" as L5
  usecase "Xem quỹ phép" as L2
  usecase "Hủy / điều chỉnh\nđơn đã duyệt" as L3
}
rectangle "HR" as G2 {
  usecase "Cấu hình điểm chấm công,\ngắn máy quầy" as A5
  usecase "Xác minh / điều chỉnh công" as A6
  usecase "Chốt công" as A7
}
rectangle "Máy chấm công tại quầy" as G4 {
  usecase "Quét QR cá nhân\nbằng camera" as K1
  usecase "Chụp ảnh minh chứng\ntại quầy" as A3
}
rectangle "Người duyệt" as G3 {
  usecase "Duyệt hoặc từ chối đơn\n(từ chối bắt buộc lý do)" as L4
  usecase "Gửi thông báo kết quả" as L6
}
EMP --> G1
G2 <-- HR
G3 <-- MGR
A1 .> A2 : <<include>>
A1 .> K1 : <<include>>
A1 .> A3 : <<include>>
G4 <-- KIOSK
L1 .> L5 : <<include>>
L4 .> L6 : <<include>>
L3 .> L4 : <<extend>>
MGR --> A6 : xác minh công team
G1 -[hidden]right-> G2
G1 -[hidden]right-> G3
G1 -[hidden]right-> G4
@enduml
