@startuml uc06_qr_attendance
skinparam defaultFontColor #000000
skinparam defaultFontSize 12
skinparam backgroundColor #FFFFFF

skinparam actor {
    BorderColor #333333
    BackgroundColor #FFFFFF
    FontColor #000000
}

skinparam usecase {
    BorderColor #333333
    BackgroundColor #E1F5FE
    FontColor #000000
    ArrowColor #333333
    ArrowFontColor #000000
}

skinparam package {
    BorderColor #000000
    FontColor #000000
    BackgroundColor #FFFFFF
}

left to right direction

actor "Employee / Manager / HR\n(người chấm công)" as Employee
actor "Máy chấm công tại quầy\n(tài khoản thiết bị KIOSK)" as Kiosk
actor "HR\n(cấu hình điểm chấm công)" as HR
actor "Admin\n(tạo/khóa tài khoản KIOSK)" as Admin

package "UC-06 - Chấm công tại quầy (QR cá nhân + ảnh minh chứng) – MVP" {
    usecase "UC-06\nChấm công tại quầy" as UC06
    usecase "Hiển thị QR cá nhân động\n(hạn 15s, dùng một lần)" as UC_MyQr
    usecase "Quét QR cá nhân bằng camera" as UC_Scan
    usecase "Xác thực QR & xác định\ncheck-in / check-out" as UC_AuthQR
    usecase "Chụp ảnh minh chứng tại quầy\n(nén ≤ 200KB)" as UC_Photo
    usecase "Ghi công: giờ server, điểm,\nmáy quầy, ảnh" as UC_Save
    usecase "Xem kết quả chấm công trên web" as UC_View
    usecase "Báo lỗi QR hết hạn / đã dùng /\nkhông hợp lệ" as UC_ErrQR
    usecase "Cấu hình điểm chấm công,\ngắn máy quầy" as UC_Point
    usecase "Tạo / khóa tài khoản KIOSK" as UC_Account
}

Employee --> UC06
Employee --> UC_MyQr
Employee --> UC_View
Kiosk --> UC_Scan
Kiosk --> UC_Photo
HR --> UC_Point
Admin --> UC_Account

UC06 ..> UC_MyQr : <<include>>
UC06 ..> UC_Scan : <<include>>
UC_Scan ..> UC_AuthQR : <<include>>
UC06 ..> UC_Photo : <<include>>
UC06 ..> UC_Save : <<include>>
UC_ErrQR ..> UC_AuthQR : <<extend>>

@enduml
