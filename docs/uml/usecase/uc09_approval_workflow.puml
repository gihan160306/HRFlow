@startuml uc09_approval_workflow
skinparam defaultFontColor #000000
skinparam defaultFontSize 12
skinparam backgroundColor #FFFFFF

skinparam actor {
    BorderColor #333333
    BackgroundColor #FFFFFF
    FontColor #000000
}

skinparam usecase {
    BorderColor #333333
    BackgroundColor #E1F5FE
    FontColor #000000
    ArrowColor #333333
    ArrowFontColor #000000
}

skinparam package {
    BorderColor #000000
    FontColor #000000
    BackgroundColor #FFFFFF
}

left to right direction

actor "Người duyệt chính theo tuyến\n(Lead / Sales Manager / Operations Manager /\nDirector – role Manager; HR Lead – role HR)" as Primary
actor "Người dự phòng đã chỉ định trước\n(theo bảng tuyến company_profile Mục 4)" as Backup

package "UC-09 - Quy trình phê duyệt đơn từ (PTO / OT) – một cấp" {
    usecase "UC-09\nPhê duyệt đơn từ" as UC09
    usecase "Xác định người duyệt theo tuyến\n(không suy từ role; không mặc định HR)" as UC_Route
    usecase "Chặn tự duyệt đơn của chính mình" as UC_NoSelf
    usecase "Ghi lý do dùng người dự phòng" as UC_BackupReason
    usecase "Xem chi tiết đơn chờ duyệt (Pending)" as UC_View
    usecase "Phê duyệt (Approve) đơn" as UC_Approve
    usecase "Từ chối (Reject) đơn" as UC_Reject
    usecase "Nhập lý do từ chối" as UC_Reason
    usecase "Ghi nhật ký kiểm toán (Approval Log)" as UC_Log
    usecase "Gửi thông báo kết quả (In-app / Email)" as UC_Notif
}

Primary --> UC09
Backup --> UC09

UC09 ..> UC_Route : <<include>>
UC09 ..> UC_NoSelf : <<include>>
UC_BackupReason ..> UC09 : <<extend>>\n[người duyệt chính vắng mặt/xung đột]
UC09 ..> UC_View : <<include>>
UC09 ..> UC_Approve : <<include>>
UC09 ..> UC_Reject : <<include>>
UC_Reason ..> UC_Reject : <<extend>>
UC09 ..> UC_Log : <<include>>
UC09 ..> UC_Notif : <<include>>

note bottom of UC_Route
  Không có người duyệt hợp lệ (chính và dự phòng đều không xử lý được)
  → đơn giữ PENDING, không tự chuyển cho HR hoặc người khác.
end note

@enduml