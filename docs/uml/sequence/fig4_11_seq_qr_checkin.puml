@startuml fig4_11_seq_qr_checkin
!include _style.puml
skinparam maxMessageSize 140
skinparam ParticipantPadding 8
skinparam responseMessageBelowArrow true
autonumber
actor "Employee" as E
participant "Điện thoại\n(MyQrModal – React)" as PH
participant "Máy chấm công tại quầy\n(KioskPage – React,\ntài khoản KIOSK)" as K
participant "AttendanceController /\nKioskController" as C
participant "EmployeeQrService /\nKioskService" as S
participant AttendanceCalc as CALC
database PostgreSQL as DB
== Bước 1: nhân viên hiển thị QR cá nhân động ==
E -> PH : đăng nhập, bấm "Chấm công"
PH -> C : GET /attendance/my-qr
C -> S : issueMyQr()
S -> S : employeeId lấy từ token\n(không tin client)
S -> DB : hủy mã cũ còn hiệu lực;\nINSERT employee_qr_token\n(nonce, expires_at = now + 15s)
S --> PH : qrPayload "HRFLOW-EMP:<nonce>", hạn 15s
PH -> PH : hiển thị QR + đếm ngược,\ntự lấy mã mới trước khi hết hạn
== Bước 2: máy quầy quét QR (chưa ghi công) ==
E -> K : đưa màn hình điện thoại vào camera
K -> K : camera đọc QR
K -> C : POST /kiosk/scan {qrPayload}
C -> S : scan(kioskAccount, payload)
S -> DB : SELECT employee_qr_token theo nonce FOR UPDATE;\nkiểm tra điểm chấm công của máy quầy
alt QR không hợp lệ / hết hạn / đã dùng
  S -> DB : ghi audit lượt quét bị từ chối
  S --> K : 422 QR_INVALID / QR_EXPIRED / QR_USED
  K -> K : báo lỗi, quay lại chế độ quét
else quét lại quá sớm / đã đủ vào–ra
  S --> K : 409 TOO_SOON_TO_CHECK_OUT / ALREADY_CHECKED_OUT
else hợp lệ
  S -> DB : UPDATE employee_qr_token\n(scanned_at, scanned_by, punch_type,\npunch_deadline = +30s)
  S --> K : 200 {scanId, tên NV, CHECK_IN | CHECK_OUT}
end
== Bước 3: chụp ảnh minh chứng tại quầy và ghi công ==
K -> K : "Xin chào <tên>", đếm 3-2-1,\nchụp khung hình từ camera, nén ≤ 200 KB
K -> C : POST /kiosk/punch {scanId, ảnh}
C -> S : punch(kioskAccount, scanId, ảnh)
alt phiên quét hết hạn / thiếu hoặc sai ảnh
  S --> K : 422 SCAN_EXPIRED / PHOTO_REQUIRED / PHOTO_TOO_LARGE
else hợp lệ
  S -> DB : INSERT attendance_photo (captured_by = máy quầy)
  S -> CALC : tính phút làm việc, trễ/sớm theo lịch cá nhân
  CALC --> S : kết quả
  S -> DB : INSERT/UPDATE attendance_record\n(giờ = scanned_at, điểm & máy quầy, nonce, ảnh,\nstatus VALID hoặc NEEDS_REVIEW)
  S -> DB : UPDATE employee_qr_token SET used_at; ghi audit
  S --> K : 200 {tên NV, hành động, giờ ghi nhận}
  K -> K : hiển thị kết quả vài giây,\nquay lại chế độ quét
end
== Bước 4: điện thoại hiển thị kết quả ==
PH -> C : GET /attendance/today (hỏi lại vài giây/lần)
C --> PH : bản ghi công hôm nay
PH --> E : "Check-in thành công lúc 08:02"
@enduml
